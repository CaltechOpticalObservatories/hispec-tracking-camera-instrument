PARAMETER0="Start=1"
PARAMETER1="Expose=0"
PARAMETER2="ExposeWindow=0"
PARAMETER3="exptime=0"
PARAMETER4="longexposure=0"
PARAMETER5="Abort=0"
PARAMETER6="freerun=0"
PARAMETER7="mode_UTR_RR=0"
PARAMETER8="guiding=0"
PARAMETER9="mode_UTR_GR=0"
PARAMETER10="mode_EnhancedRollingReset=0"
PARAMETER11="mode_RX=0"
PARAMETER12="mode_RXR=0"
PARAMETER13="mode_PermanentReset=0"
PARAMETER14="mode_Guiding=0"
PARAMETER15="mode_InterleavedGuiding=0"
PARAMETER16="exp_PulseWhileGlobReset=0"
PARAMETER17="H2RG_rows=2048"
PARAMETER18="H2RG_rows_skip=0"
PARAMETER19="H2RG_columns=512"
PARAMETER20="H2RGMainReset=0"
PARAMETER21="EnhancedRR_Delta=100"
PARAMETER22="Hold4Programming=0"
PARAMETER23="WindowPixelNb=100"
PARAMETER24="reset_while_idling=1"
PARAMETER25="prv_flag_reset=0"
PARAMETER26="const_prv_total_rows=2048"
PARAMETER27="const_prv_total_columns=512"
PARAMETER28="prv_started_idle_readout=0"
PARAMETER29="prv_idle_counter=0"
PARAMETERS=30
LINE0=Init:
LINE1="STATE000; CALL InitClocks"
LINE2="STATE000; CALL wCLKEn"
LINE3="STATE000; CALL ResetRegistersDefault"
LINE4="STATE000; if Start GOTO WaitForExpose"
LINE5="STATE000; GOTO Init"
LINE6=ResetRegHxRG:
LINE7="STATE000; CALL ResetRegistersDefault"
LINE8="STATE000; if H2RGMainReset CALL Dec_H2RGMainReset"
LINE9="STATE000; RETURN ResetRegHxRG"
LINE10=WaitForExpose:
LINE11="STATE000; if Expose GOTO SelectMode"
LINE12="STATE000; if H2RGMainReset CALL ResetRegHxRG"
LINE13="STATE000; if reset_while_idling CALL IdleReadout"
LINE14="STATE000; GOTO WaitForExpose"
LINE15=IdleReadout:
LINE16="STATE000; if !prv_started_idle_readout CALL StartFrame"
LINE17="STATE000; if !prv_started_idle_readout CALL Inc_prv_idle_counter(const_prv_total_rows)"
LINE18="STATE000; if !prv_started_idle_readout CALL Inc_prv_started_idle_readout"
LINE19="STATE000; CALL Dec_prv_idle_counter"
LINE20="STATE000; if Expose CALL Test_Dec_prv_idle_counter(const_prv_total_rows)"
LINE21="STATE000; if prv_idle_counter GOTO IdleReadoutRow"
LINE22="STATE000; if !prv_idle_counter CALL PulseVCLK"
LINE23="STATE000; if !prv_idle_counter CALL Test_Dec_prv_started_idle_readout"
LINE24="STATE000; RETURN IdleReadout"
LINE25=IdleReadoutRow:
LINE26="STATE000; CALL StartRow"
LINE27="STATE000; CALL wReadEN"
LINE28="STATE000; CALL ReadPixel_Blank(2)"
LINE29="STATE000; CALL ReadPixel_Blank(const_prv_total_columns)"
LINE30="STATE000; CALL ResetPulse"
LINE31="STATE000; CALL wbHclk"
LINE32="STATE000; CALL wbReadEN"
LINE33="STATE000; GOTO IdleReadout"
LINE34=SelectMode:
LINE35="STATE000; if mode_UTR_RR CALL UTR_RR_Sequence"
LINE36="STATE000; if mode_UTR_GR CALL UTR_GR_Sequence"
LINE37="STATE000; if mode_RX CALL RX_Sequence"
LINE38="STATE000; if mode_RXR CALL RXR_Sequence"
LINE39="STATE000; if mode_PermanentReset CALL PGR_Sequence"
LINE40="STATE000; if mode_EnhancedRollingReset CALL EnhancedRR_Sequence"
LINE41="STATE000; if exp_PulseWhileGlobReset CALL Persistence_PulseGlobalReset"
LINE42="STATE000; if mode_Guiding CALL Guiding_Sequence"
LINE43="STATE000; GOTO WaitForExpose"
LINE44=UTR_RR_Sequence:
LINE45="STATE000; prv_flag_reset++"
LINE46="STATE000; CALL UTR_RR_GrabFrame(Expose)"
LINE47="STATE000; GOTO WaitForExpose"
LINE48=UTR_RR_GrabFrame:
LINE49="STATE000; if Expose CALL Dec_Expose"
LINE50="STATE000; if !prv_flag_reset CALL ExposureTimer"
LINE51="STATE000; CALL wFrame"
LINE52="STATE000; CALL StartFrame"
LINE53="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE54="STATE000; CALL RR_ReadRow(H2RG_rows)"
LINE55="STATE000; CALL PulseVCLK"
LINE56="STATE000; if prv_flag_reset CALL Dec_prv_flag_reset"
LINE57="STATE000; RETURN UTR_RR_GrabFrame"
LINE58=RR_ReadRow:
LINE59="STATE000; CALL wLine"
LINE60="STATE000; CALL StartRow"
LINE61="STATE000; CALL wReadEN"
LINE62="STATE000; if prv_flag_reset CALL ResetPulse"
LINE63="STATE000; if !prv_flag_reset CALL ResetPulse_Dummy"
LINE64="STATE000; CALL ReadPixel_Blank(2)"
LINE65="STATE000; CALL ReadPixel(H2RG_columns)"
LINE66="STATE000; CALL wbHclk"
LINE67="STATE000; CALL wbReadEN"
LINE68="STATE000; RETURN RR_ReadRow"
LINE69=RR_SkipRow:
LINE70="STATE000; CALL StartRow"
LINE71="STATE000; CALL wDelay1us"
LINE72="STATE000; if prv_flag_reset CALL ResetPulse"
LINE73="STATE000; RETURN RR_SkipRow"
LINE74=UTR_GR_Sequence:
LINE75="STATE000; prv_flag_reset++"
LINE76="STATE000; CALL UTR_GR_GrabFrame(Expose)"
LINE77="STATE000; GOTO WaitForExpose"
LINE78=PGR_Sequence:
LINE79="STATE000; CALL wResetEN"
LINE80="STATE000; CALL UTR_GR_GrabFrame(Expose)"
LINE81="STATE000; CALL wbResetEN"
LINE82="STATE000; GOTO WaitForExpose"
LINE83=UTR_GR_GrabFrame:
LINE84="STATE000; if Expose CALL Dec_Expose"
LINE85="STATE000; CALL wFrame"
LINE86="STATE000; CALL StartFrame"
LINE87="STATE000; CALL PulseVCLK"
LINE88="STATE000; CALL GR_ReadRow(2048)"
LINE89="STATE000; CALL PulseVCLK"
LINE90="STATE000; if prv_flag_reset CALL Dec_prv_flag_reset"
LINE91="STATE000; RETURN UTR_GR_GrabFrame"
LINE92=GR_ReadRow:
LINE93="STATE000; CALL wLine"
LINE94="STATE000; CALL StartRow"
LINE95="STATE000; CALL wReadEN"
LINE96="STATE000; CALL ReadPixel_Blank(2)"
LINE97="STATE000; CALL ReadPixel(64)"
LINE98="STATE000; CALL wbHclk"
LINE99="STATE000; CALL wbReadEN"
LINE100="STATE000; RETURN GR_ReadRow"
LINE101=RX_Sequence:
LINE102="STATE000; CALL RX_GrabFrame"
LINE103="STATE000; if Abort CALL AbortSeq"
LINE104="STATE000; if freerun GOTO RX_Sequence"
LINE105="STATE000; GOTO WaitForExpose"
LINE106=RX_GrabFrame:
LINE107="STATE000; CALL wFrame"
LINE108="STATE000; CALL StartFrame"
LINE109="STATE000; if H2RG_rows_skip CALL RR_SkipRow(H2RG_rows_skip)"
LINE110="STATE000; CALL RX_ReadRow(H2RG_rows)"
LINE111="STATE000; CALL PulseVCLK"
LINE112="STATE000; CALL ExposureTimer"
LINE113="STATE000; CALL DecreaseExposeCount"
LINE114="STATE000; RETURN RX_GrabFrame"
LINE115=RX_ReadRow:
LINE116="STATE000; CALL wLine"
LINE117="STATE000; CALL StartRow"
LINE118="STATE000; CALL wReadEN"
LINE119="STATE000; CALL ReadPixel_Blank(2)"
LINE120="STATE000; CALL ReadPixel(H2RG_columns)"
LINE121="STATE000; CALL ResetPulse"
LINE122="STATE000; CALL wbHclk"
LINE123="STATE000; CALL wbReadEN"
LINE124="STATE000; RETURN RX_ReadRow"
LINE125=RXR_Sequence:
LINE126="STATE000; CALL RXR_GrabFrame"
LINE127="STATE000; if Abort CALL AbortSeq"
LINE128="STATE000; if freerun GOTO RXR_Sequence"
LINE129="STATE000; GOTO WaitForExpose"
LINE130=RXR_GrabFrame:
LINE131="STATE000; CALL wFrame"
LINE132="STATE000; CALL StartFrame"
LINE133="STATE000; CALL StartRow"
LINE134="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE135="STATE000; CALL RXR_ReadRow(H2RG_rows)"
LINE136="STATE000; CALL PulseVCLK"
LINE137="STATE000; CALL ExposureTimer"
LINE138="STATE000; CALL DecreaseExposeCount"
LINE139="STATE000; RETURN RXR_GrabFrame"
LINE140=RXR_ReadRow:
LINE141="STATE000; CALL wLine"
LINE142="STATE000; CALL StartRow"
LINE143="STATE000; CALL wReadEN"
LINE144="STATE000; CALL ReadPixel_Blank(2)"
LINE145="STATE000; CALL ReadPixel(H2RG_columns)"
LINE146="STATE000; CALL ResetPulse"
LINE147="STATE000; CALL LSyncBPulse"
LINE148="STATE000; CALL ReadPixel_Blank(1)"
LINE149="STATE000; CALL ReadPixel(H2RG_columns)"
LINE150="STATE000; CALL wbHclk"
LINE151="STATE000; CALL wbReadEN"
LINE152="STATE000; RETURN RXR_ReadRow"
LINE153=Persistence_PulseGlobalReset:
LINE154="STATE000; CALL wResetEN"
LINE155="STATE000; CALL UTR_GR_GrabFrame(10)"
LINE156="STATE000; CALL wbResetEN"
LINE157="STATE000; CALL UTR_GR_GrabFrame(100)"
LINE158="STATE000; RETURN Persistence_PulseGlobalReset"
LINE159=EnhancedRR_Sequence:
LINE160="STATE000; CALL ConfigureEnhancedMode"
LINE161="STATE000; CALL EnhancedRR_GrabFrame(Expose)"
LINE162="STATE000; GOTO WaitForExpose"
LINE163=EnhancedRR_GrabFrame:
LINE164="STATE000; if Expose CALL Dec_Expose"
LINE165="STATE000; CALL wFrame"
LINE166="STATE000; CALL wbFSyncB"
LINE167="STATE000; CALL HDCRR_ReadRow(EnhancedRR_Delta)"
LINE168="STATE000; CALL wFSyncB"
LINE169="STATE000; CALL HDCRR_ReadRow(1948)"
LINE170="STATE000; RETURN EnhancedRR_GrabFrame"
LINE171=HDCRR_ReadRow:
LINE172="STATE000; CALL wLine"
LINE173="STATE000; CALL PulseVCLK"
LINE174="STATE000; CALL wbVReadEdge"
LINE175="STATE000; CALL LSyncBPulse"
LINE176="STATE000; CALL wReadEN"
LINE177="STATE000; CALL ResetPulse"
LINE178="STATE000; CALL ReadPixel_Blank(1)"
LINE179="STATE000; CALL ReadPixel(64)"
LINE180="STATE000; CALL wVReadEdge"
LINE181="STATE000; CALL LSyncBPulse"
LINE182="STATE000; CALL ReadPixel_Blank(1)"
LINE183="STATE000; CALL ReadPixel(64)"
LINE184="STATE000; CALL wbReadEN"
LINE185="STATE000; RETURN HDCRR_ReadRow"
LINE186=Guiding_Sequence:
LINE187="STATE000; if Expose CALL GrabWindow"
LINE188="STATE000; if Abort CALL AbortSeq"
LINE189="STATE000; GOTO Guiding_Sequence"
LINE190=GrabWindow:
LINE191="STATE000; if Expose CALL Dec_Expose"
LINE192="STATE000; CALL wFrame"
LINE193="STATE000; CALL StartFrame"
LINE194="STATE000; CALL WinRX_ReadRow(H2RG_rows)"
LINE195="STATE000; CALL PulseVCLK"
LINE196="STATE000; CALL ExposureTimer"
LINE197="STATE000; RETURN GrabWindow"
LINE198=WinRX_ReadRow:
LINE199="STATE000; CALL wLine"
LINE200="STATE000; CALL StartRow"
LINE201="STATE000; CALL wReadEN"
